*.py text eol=lf
*.sh text eol=lf
*.slurm text eol=lf
*.ipynb text eol=lf
*.npy binary
*.npz binary
*.pkl binary
*.gz binary
*.png binary
*.pdf binary

# Preserve exact archived bytes across Git clients and operating systems.
# These rules preserve archived bytes independently of LFS storage.
/FE_Results_Cases_All/** -text
/outputs/** -text
/shared/** -text
/provenance/** -text
/logs/** -text
/reports/** -text
/formula_appendix/** -text

# Install Git LFS before staging files. Small tables and figures remain in Git.
/FE_Results_Cases_All/*.txt filter=lfs diff=lfs merge=lfs -text
*.npy filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text
